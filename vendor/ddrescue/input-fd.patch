 namespace {
+
+// Modified by CardRescue contributors, 2026-10-07, under GPL-2.0-or-later.
+// macOS fdesc reopening rechecks raw-device permissions. Duplicate the
+// already-authorized read-only descriptor instead; no privileged process needed.
+int open_input( const char * const name, const int flags )
+  {
+  const char * const prefix = "/dev/fd/";
+  if( std::strncmp( name, prefix, std::strlen( prefix ) ) != 0 )
+    return open( name, flags );
+  const char * const number = name + std::strlen( prefix );
+  char * end = 0;
+  errno = 0;
+  const long fd = std::strtol( number, &end, 10 );
+  if( errno || end == number || *end || fd < 0 || fd > INT_MAX )
+    { errno = EINVAL; return -1; }
+  const int mode = fcntl( fd, F_GETFL );
+  if( mode < 0 ) return -1;
+  if( ( mode & O_ACCMODE ) != O_RDONLY )
+    { errno = EACCES; return -1; }
+  if( flags & O_DIRECT ) { errno = ENOTSUP; return -1; }
+  return dup( fd );
+  }
 
